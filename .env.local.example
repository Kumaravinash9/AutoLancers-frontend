# Copy to .env.local
# Backend runs on 8010 by default (8000 is commonly already taken).
NEXT_PUBLIC_API_URL=http://localhost:8010

# The browser extension's id, so this app can talk to it directly — both run in the same browser, so
# "you're signed out of Upwork" can reach an open tab without going through the backend.
#
# A web page cannot discover an extension's id, and a "Load unpacked" build gets a different one per
# machine: find it at chrome://extensions with Developer mode on. Left unset, the app simply reports
# the extension as not installed and falls back to the backend's recorded status, which is the honest
# answer when it genuinely isn't there.
NEXT_PUBLIC_EXTENSION_ID=
